# DISABLED. Promote only after actual owner-local secret/public-key setup is verified.
# User-approved publication design; this file does not run in its current location/name.
name: Publish signed Rust Duty updates (manual draft)
on:
  workflow_dispatch:
    inputs:
      version:
        description: New stable version (must increase)
        required: true
      sequence:
        description: New positive monotonic sequence (must increase)
        required: true
      previous_version:
        description: Previous signed release version; leave empty only for the first channel release
        required: false
permissions:
  contents: read
concurrency:
  group: rust-duty-signed-release
  cancel-in-progress: false
jobs:
  build:
    if: github.repository == 'RHS059/rust_duty' && github.ref == 'refs/heads/main'
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            target: x86_64-unknown-linux-gnu
            game: vector-range
          - os: windows-latest
            target: x86_64-pc-windows-msvc
            game: vector-range.exe
    runs-on: ${{ matrix.os }}
    env:
      RUST_DUTY_UPDATE_PUBLIC_KEY: ${{ vars.RUST_DUTY_UPDATE_PUBLIC_KEY }}
      RELEASE_VERSION: ${{ inputs.version }}
      RELEASE_SEQUENCE: ${{ inputs.sequence }}
      PREVIOUS_VERSION: ${{ inputs.previous_version }}
      RELEASE_TARGET: ${{ matrix.target }}
      GAME_FILE: ${{ matrix.game }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install cryptography
      - name: Validate public setup, release identifiers and approved public asset
        shell: bash
        run: |
          python - <<'PY'
          import hashlib, os, re
          from pathlib import Path
          assert re.fullmatch(r'[0-9a-f]{64}', os.environ['RUST_DUTY_UPDATE_PUBLIC_KEY']), 'Owner-local public-key setup is missing'
          assert re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', os.environ['RELEASE_VERSION'])
          assert int(os.environ['RELEASE_SEQUENCE']) > 0
          asset = Path('assets/weapons/hk416a5.vrm')
          assert hashlib.sha256(asset.read_bytes()).hexdigest() == '082b8302a39c8fd3218f3c732f8c3a06c1af1fb40f703f8d64f581b38b32d4aa', 'Approved runtime sidecar must be present; never import private originals'
          Path('release-public-key.hex').write_text(os.environ['RUST_DUTY_UPDATE_PUBLIC_KEY'] + '\n')
          PY
      - name: Linux audio headers
        if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libasound2-dev
      - run: cargo fetch --manifest-path updater/Cargo.toml --locked
      - run: cargo test --manifest-path updater/Cargo.toml --locked
      - run: cargo build --locked --release
      - run: cargo build --manifest-path updater/Cargo.toml --locked --release --bins
      - run: python tools/collect_updater_licenses.py
      - name: Verify the previous signed baseline for an actual delta
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir -p baseline
          if [ -n "$PREVIOUS_VERSION" ]; then
            python -c 'import os; from tools.release_update import stable_version; assert stable_version(os.environ["PREVIOUS_VERSION"]) < stable_version(os.environ["RELEASE_VERSION"])'
            gh release download "v$PREVIOUS_VERSION" --repo github.com/RHS059/rust_duty \
              --pattern "rust-duty-$PREVIOUS_VERSION-$RELEASE_TARGET.rdb" \
              --pattern "update-$RELEASE_TARGET.json" --dir baseline
            python tools/release_update.py verify \
              --manifest "baseline/update-$RELEASE_TARGET.json" --public-key release-public-key.hex \
              --assets-dir baseline --bundle-only --version "$PREVIOUS_VERSION" --target "$RELEASE_TARGET" > baseline/verified.json
            python -c 'import json,os; assert int(os.environ["RELEASE_SEQUENCE"]) > json.load(open("baseline/verified.json"))["sequence"]'
          else
            count=$(gh api --hostname github.com 'repos/RHS059/rust_duty/releases?per_page=100' --jq '[.[] | select(.draft == false) | .assets[]? | .name | select(startswith("update-") and endswith(".json"))] | length')
            if [ "$count" != "0" ]; then echo 'A signed channel already exists; supply its previous_version to generate actual deltas'; exit 1; fi
          fi
      - name: Prepare payload, true delta and pinned bootstrap
        shell: bash
        run: |
          mkdir -p release-payload/assets/weapons release-assets
          cp "target/release/$GAME_FILE" release-payload/
          cp LICENSE THIRD_PARTY_LICENSES.txt release-payload/
          cp assets/weapons/hk416a5.vrm release-payload/assets/weapons/
          # No private-assets directory, source FBX/GLB, arms, settings or wildcard asset import.
          previous_args=()
          if [ -n "$PREVIOUS_VERSION" ]; then
            previous_args=(--previous "baseline/rust-duty-$PREVIOUS_VERSION-$RELEASE_TARGET.rdb" --previous-version "$PREVIOUS_VERSION")
          fi
          python tools/release_update.py prepare --input release-payload --output release-assets \
            --version "$RELEASE_VERSION" --sequence "$RELEASE_SEQUENCE" --target "$RELEASE_TARGET" \
            --entrypoint "$GAME_FILE" "${previous_args[@]}"
          python tools/package_updater.py --output bootstrap --expected-public-key "$RUST_DUTY_UPDATE_PUBLIC_KEY"
          python -c 'import os,shutil; shutil.make_archive("release-assets/rust-duty-bootstrap-" + os.environ["RELEASE_VERSION"] + "-" + os.environ["RELEASE_TARGET"], "zip", "bootstrap")'
      - uses: actions/upload-artifact@v4
        with:
          name: prepared-update-${{ matrix.target }}
          path: release-assets/
          if-no-files-found: error
  publish:
    needs: build
    if: github.repository == 'RHS059/rust_duty' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    env:
      RELEASE_VERSION: ${{ inputs.version }}
      RELEASE_SEQUENCE: ${{ inputs.sequence }}
      RUST_DUTY_UPDATE_PUBLIC_KEY: ${{ vars.RUST_DUTY_UPDATE_PUBLIC_KEY }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@stable
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/download-artifact@v4
        with:
          pattern: prepared-update-*
          merge-multiple: true
          path: release-assets/
      - run: python -m pip install cryptography
      - name: Build signing helper before the private secret enters any process environment
        run: cargo build --manifest-path updater/Cargo.toml --locked --release --bin rust-duty-release-sign
      - name: Sign via stdin and verify each exact manifest and asset
        shell: bash
        env:
          RUST_DUTY_RELEASE_SIGNING_KEY: ${{ secrets.RUST_DUTY_RELEASE_SIGNING_KEY }}
        run: |
          test -n "$RUST_DUTY_RELEASE_SIGNING_KEY" || { echo 'Owner-local signing secret is missing'; exit 1; }
          printf '%s\n' "$RUST_DUTY_UPDATE_PUBLIC_KEY" > release-public-key.hex
          for payload in release-assets/update-*.payload.json; do
            signature="${payload%.payload.json}.sig"
            manifest="${payload%.payload.json}.json"
            printf '%s' "$RUST_DUTY_RELEASE_SIGNING_KEY" | updater/target/release/rust-duty-release-sign sign \
              --private-key-stdin --payload "$payload" --signature "$signature"
            python tools/release_update.py seal --payload "$payload" --signature "$signature" \
              --public-key release-public-key.hex --output "$manifest"
            python tools/release_update.py verify --manifest "$manifest" --public-key release-public-key.hex \
              --assets-dir release-assets --version "$RELEASE_VERSION" > /dev/null
          done
      - name: Publish immutable versioned assets; mark latest only after uploading
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tag="v$RELEASE_VERSION"
          if gh release view "$tag" --repo github.com/RHS059/rust_duty > /dev/null 2>&1; then
            echo 'This version already exists. Refusing to replace published update assets.'; exit 1
          fi
          assets=()
          for file in release-assets/*; do
            case "$file" in
              *.payload.json|*.sig) ;;
              *.rdb|*.rdd|*.zip|*/update-*.json) assets+=("$file") ;;
            esac
          done
          test "${#assets[@]}" -ge 6
          gh release create "$tag" --repo github.com/RHS059/rust_duty --target "$GITHUB_SHA" --draft \
            --title "Rust Duty $RELEASE_VERSION" --notes "Signed game update and pinned bootstrap. Install the bootstrap once; subsequent compatible releases use resumable copy/add deltas."
          gh release upload "$tag" "${assets[@]}" --repo github.com/RHS059/rust_duty
          gh release edit "$tag" --repo github.com/RHS059/rust_duty --draft=false --latest
# No id-token permission, key generation, token creation, secret-setting command,
# automatic trigger, private asset glob or bootstrap runtime trust override.
