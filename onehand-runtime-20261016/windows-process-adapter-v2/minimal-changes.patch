+    def test_f1_jsonl_cancelled_stderr_not_success(self):self.assert_incomplete_stream('jsonl',stdout=True)
+    def test_f1_jsonl_cancelled_stdout_not_success(self):self.assert_incomplete_stream('jsonl',stderr=True)
